{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PROJECT_DIR}/.harness/harness.py\" ] || exit 0; exec python3 \"${CLAUDE_PROJECT_DIR}/.harness/harness.py\" verify --stop-hook --root \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 .harness/harness.py *)"
    ],
    "ask": [
      "Bash(*harness.py reseal*)",
      "Edit(/.harness/ledger.json)",
      "Edit(/.harness/harness.py)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)"
    ]
  }
}
